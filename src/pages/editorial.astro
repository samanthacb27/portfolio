---
// @ts-nocheck  (stops VS Code underlining the file-reading lines; the code works fine)
/* =====================================================================
   EDITORIAL PAGE: a horizontal, magazine-style row of covers (covers only,
   no titles or captions). Clicking a finished magazine opens the viewer.

   The magazines come from the files in src/content/editorial/ (one file each).
   To change the order, edit "order" in those files. 1 is the leftmost cover.
   ===================================================================== */
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import MagazineViewer from '../components/MagazineViewer.astro';

const entries = (await getCollection('editorial')).sort((a, b) => a.data.order - b.data.order);

const projects = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);   // the caption (the text written under the front matter)
    let flipbook = null;

    if (entry.data.status === 'flipbook') {
      const folder = entry.data.pagesFolder ?? entry.id;
      const manifestPath = path.join(process.cwd(), 'public', 'flipbooks', folder, 'manifest.json');
      if (!fs.existsSync(manifestPath)) {
        throw new Error(
          `The magazine "${entry.id}" is set to "flipbook", but its pages are not in public/flipbooks/${folder}/ yet.\n` +
          `Run this in the terminal:  node scripts/make-flipbook.mjs "/path/to/your.pdf" ${folder}\n` +
          `(or set  status: in-progress  in src/content/editorial/${entry.id}.md until it is ready).`
        );
      }
      const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
      flipbook = { folder, ...manifest };
    }
    return { entry, Content, flipbook };
  })
);
---
<BaseLayout
  title="Editorial"
  description="Editorial work by Samantha Brenneman: magazines she has edited and designed, which you can flip through page by page."
>
  <section class="editorial">
    <h1 class="sr-only">Editorial</h1>

    <div class="scroller" role="region" aria-label="Editorial: magazine covers. Scroll sideways for more." tabindex="0">
      {projects.map(({ entry, flipbook }, i) => {
        const cover = entry.data.cover;
        const ratio = `${cover.width} / ${cover.height}`;
        return flipbook ? (
          <button
            class="cover"
            type="button"
            style={`aspect-ratio: ${ratio}`}
            data-magazine={entry.id}
            data-folder={flipbook.folder}
            data-count={flipbook.pageCount}
            data-width={flipbook.width}
            data-height={flipbook.height}
            data-title={entry.data.title}
          >
            <Image
              src={cover}
              alt={entry.data.coverAlt}
              widths={[280, 420, 560, 840]}
              sizes="(max-width: 760px) 280px, 420px"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="sr-only">Open {entry.data.title}</span>
          </button>
        ) : (
          <div class="cover inert" style={`aspect-ratio: ${ratio}`}>
            <Image
              src={cover}
              alt={`${entry.data.coverAlt} (in progress)`}
              widths={[280, 420, 560, 840]}
              sizes="(max-width: 760px) 280px, 420px"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        );
      })}
    </div>

    {/* Each finished magazine's caption waits here, unseen, until its viewer opens */}
    {projects.filter((p) => p.flipbook).map(({ entry, Content }) => (
      <template id={`caption-${entry.id}`}><Content /></template>
    ))}
  </section>

  <MagazineViewer />
</BaseLayout>

<style>
  .editorial {
    /* Same idea as the Home page: the row sits in the middle of the first screen, footer below the fold */
    min-height: calc(100vh - 3rem);
    min-height: calc(100svh - 3rem);
    display: flex; flex-direction: column; justify-content: center;
    padding-bottom: 3rem;
  }
  @media (max-width: 760px) {
    .editorial { min-height: calc(100svh - 3rem - 4.5rem); }
  }

  /* The row runs to the screen edge, but the first cover lines up with the page margin */
  .scroller {
    display: flex; gap: clamp(1.25rem, 3vw, 2.5rem); overflow-x: auto;
    margin-inline: calc(-1 * var(--page-pad));
    padding: 1rem var(--page-pad) 2.25rem;
    scroll-padding-inline: var(--page-pad);
    scroll-snap-type: x proximity;
    scrollbar-width: thin; scrollbar-color: var(--greige) transparent;
  }

  .cover {
    flex: none; scroll-snap-align: start; position: relative;
    height: min(62vh, 32rem); border: 0; padding: 0; background: none; display: block;
  }
  .cover :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 2px;
    box-shadow: 0 1px 2px rgba(45, 13, 26, 0.15), 0 12px 28px -10px rgba(45, 13, 26, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  button.cover { cursor: pointer; }
  button.cover:hover :global(img), button.cover:focus-visible :global(img) {
    transform: translateY(-6px);
    box-shadow: 0 1px 2px rgba(45, 13, 26, 0.15), 0 22px 36px -12px rgba(45, 13, 26, 0.4);
  }
  /* Unfinished magazines are just a picture: no hover effect, nothing to click */
  .cover.inert { cursor: default; }

  @media (prefers-reduced-motion: reduce) {
    .cover :global(img) { transition: none; }
    button.cover:hover :global(img), button.cover:focus-visible :global(img) { transform: none; }
  }
</style>
